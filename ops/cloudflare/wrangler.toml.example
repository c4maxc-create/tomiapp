name = "tomi-api-edge"
main = "worker.mjs"
compatibility_date = "2026-11-07"
workers_dev = true
# No purchased domain is required for the assigned workers.dev URL. Never commit a secret.
# routes = [{ pattern = "api.YOUR_DOMAIN/*", zone_name = "YOUR_DOMAIN" }]
[vars]
TOMI_ORIGIN = "https://tomiapp.onrender.com"
TOMI_PUBLIC_HOST = ""

[[ratelimits]]
name = "API_RATE"
namespace_id = "2042"
simple = { limit = 300, period = 60 }

[[ratelimits]]
name = "AUTH_RATE"
namespace_id = "2043"
simple = { limit = 20, period = 60 }

[observability]
enabled = false
