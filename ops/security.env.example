# Configure through your host's secret store. Never put real values in this file.
# Two-step verification is available only after setting an independent key.
TOMI_MFA_KEY=
# Enable only after the key is configured and all administrators have enrolled.
TOMI_REQUIRE_ADMIN_MFA=0
# Leave empty until an owned domain + Worker are deployed and the app URL is updated.
TOMI_EDGE_SECRET=
# Install and update ClamAV before setting this absolute path.
TOMI_CLAMSCAN_BINARY=
# Dedicated scheduler only; separate encryption key and restricted dump credentials.
TOMI_BACKUP_KEY=
TOMI_BACKUP_DATABASE_URL=
TOMI_BACKUP_DIRECTORY=/var/lib/tomi-backups
