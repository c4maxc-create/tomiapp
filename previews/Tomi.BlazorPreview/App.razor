@inject NavigationManager Navigation
@if(new Uri(Navigation.Uri).Query.Contains("native=1",StringComparison.Ordinal)){<NativeApp/>}else{
<PageTitle>TOMI PLAY — معاينة C#</PageTitle>
<div class="shell @(Reduced?"reduce-motion":"") @(Focused?"table-focused":"")">
<header><a class="brand" href="./" aria-label="TOMI PLAY الرئيسية"><span class="brand-mark">T</span>TOMI <span>PLAY</span></a><div class="header-divider"></div><span class="header-title">نادي الألعاب</span><button class="motion" @onclick="()=>Reduced=!Reduced" aria-pressed="@Reduced">@(Reduced?"الحركة مخففة":"تقليل الحركة")</button></header>
<main>
<section class="intro"><div class="hero-copy"><div class="eyebrow"><span></span> TOMI GAMES COLLECTION</div><h1>طاولتك جاهزة.<br/>الباقي <em>على مزاجك.</em></h1><p>خمس ألعاب، تفاصيل أغنى، وحركة تحت سيطرتك.<br/>اختار لعبتك من المجموعة وابدأ التجربة.</p><div class="hero-chips"><span>05 ألعاب</span><span>رسومات متجهية</span><span>تحكم تفاعلي</span></div></div><div class="hero-art" aria-hidden="true"><div class="hero-orbit"></div><div class="hero-feature"><GameArt Kind="uno"/></div><div class="hero-mini first"><GameArt Kind="jackaroo"/></div><div class="hero-mini second"><GameArt Kind="wheel"/></div><div class="hero-art-label">THE NEXT MOVE IS YOURS</div></div></section>
<div class="collection-heading"><div><small>THE COLLECTION</small><h2>اختار لعبتك</h2></div><span>كل الألعاب أمامك</span></div>
<nav class="games" aria-label="اختيار اللعبة">@foreach(var game in Games){<button data-game="@game.Id" class="game-tile @(Active==game.Id?"active":"")" @onclick="()=>SelectGame(game.Id)" aria-pressed="@(Active==game.Id)"><span class="tile-index">0@(Array.FindIndex(Games,g=>g.Id==game.Id)+1)</span><GameArt Kind="@game.Id"/><div class="tile-copy"><b>@game.Name</b><small>@game.Caption</small></div><span class="tile-arrow" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none"><path d="M12 12 4 4m0 0v8m0-8h8" stroke="currentColor" stroke-width="1.5"/></svg></span><span class="selected-label">@(Active==game.Id?"على الطاولة":"اكتشف اللعبة")</span></button>}</nav>
<div class="table-breadcrumb"><span>نادي الألعاب</span><span>/</span><b>@Games.First(g=>g.Id==Active).Name</b><button data-action="focus-toggle" aria-pressed="@Focused" @onclick="()=>Focused=!Focused">@(Focused?"إظهار المجموعة":"تركيز على الطاولة")</button></div>
<div class="session-bar"><div><span class="live-dot"></span><b>استوديو اللعب</b><small>تجربة محلية</small></div><button class="secondary" data-action="help-toggle" aria-expanded="@Help" @onclick="()=>Help=!Help">؟ طريقة التحكم</button><label>سرعة الحركة <select aria-label="سرعة الحركة" @bind="Speed"><option value="1">طبيعية</option><option value="1.6">سريعة</option><option value="0.75">هادئة</option></select></label></div>
@if(Help){<aside class="control-guide" role="region" aria-label="دليل التحكم"><b>@GuideTitle</b><p>@Guide</p><small>النتائج للتجربة المحلية. لا تؤثر على حسابك.</small></aside>}
<section class="preview" @key="Active" style="@($"--motion-speed:{(1/Speed).ToString(System.Globalization.CultureInfo.InvariantCulture)}")">
    @switch(Active){case "uno":<UnoPreview ReducedMotion="Reduced" AnimationSpeed="Speed"/>break;case "snakes":<SnakesPreview ReducedMotion="Reduced" AnimationSpeed="Speed"/>break;case "jackaroo":<JackPreview ReducedMotion="Reduced" AnimationSpeed="Speed"/>break;case "camel":<CamelPreview ReducedMotion="Reduced" AnimationSpeed="Speed"/>break;default:<WheelPreview ReducedMotion="Reduced" AnimationSpeed="Speed"/>break;}
</section>
<footer><div class="footer-brand">TOMI <small>PLAY</small></div><span>معاينة محلية تفاعلية • ما تغيّر حسابك أو رصيدك</span><span>هذه معاينة Blazor، منفصلة عن نسخة Unity</span></footer></main>
</div>

}
@code {
    void SelectGame(string id){Active=id;Help=false;}
    bool Reduced,Help,Focused;double Speed=1;string Active="uno";
    string GuideTitle=>Active switch{"uno"=>"أوراقك تحت سيطرتك","jackaroo"=>"اختار الحجر ثم الحركة","camel"=>"راقب الطبقات والخانات","snakes"=>"رحلتك إلى الخانة 100",_=>"دوران ونتيجة واضحة"};
    string Guide=>Active switch{"uno"=>"اضغط الورقة لاختيارها، ثم العبها. على لوحة المفاتيح استخدم الأسهم للتنقل وEnter للعب وD للسحب وEscape لإلغاء الاختيار. الورقة المتعددة الألوان تفتح اختيار اللون.","jackaroo"=>"اختار أحد أحجارك الحمراء ثم ورقة الحركة. التراجع يعيد أحجارك إلى مواقعها قبل آخر حركة.","camel"=>"اختار القطع المكشوفة فقط. كل ثلاث قطع متشابهة تختفي؛ لا تملأ الخانات السبع. المساعدات محدودة.","snakes"=>"ارم النرد وانتظر اكتمال الحركة. تحتاج الرقم الدقيق للوصول إلى 100.",_=>"اضغط لف العجلة وانتظر التوقف. لا توجد مراهنات أو أرصدة في هذه المعاينة."};
    static readonly (string Id,string Icon,string Name,string Caption)[] Games=[("uno","♠","أونو","ورق وحركات"),("snakes","⚄","السلم والأفعى","خطوة.. ومفاجأة"),("jackaroo","◉","جاكارو","حجر وورقة"),("camel","🐪","الجمل المجنون","طابق ثلاثة"),("wheel","✦","الروليت","لفّة للمعاينة")];
}
