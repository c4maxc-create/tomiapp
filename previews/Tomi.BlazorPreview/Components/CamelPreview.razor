@inherits PreviewComponent
<div class="game-heading"><div><small>THREE OF A KIND</small><h2>الجمل المجنون <span>• رتّبها صح</span></h2></div><button class="secondary" data-action="camel-reset" @onclick="Reset">↻ لوح جديد</button></div>
<div class="board-layout camel-layout"><div class="camel-main"><div class="camel-topline"><span>🐪 خلّ الخانة خفيفة</span><span data-testid="camel-progress">@Model.Matched / 54</span></div><div class="camel-board">@foreach(var tile in Model.Tiles.OrderBy(t=>t.Z)){var t=tile;<button class="match-tile @(Model.Free(t)?"free":"covered")" data-tile="@t.Id" data-kind="@t.Kind" disabled="@(!Model.Free(t)||Model.Lost)" style="@TileStyle(t)" aria-label="قطعة @CamelModel.Symbols[t.Kind]" @onclick="()=>Pick(t.Id)"><TileArt Kind="t.Kind"/></button>}@if(Model.Won){<div class="board-result">كفو! أفرغت اللوح ✨</div>}</div><div class="tray-heading"><b>خانة التجميع</b><span data-testid="camel-tray-count">@Model.Tray.Count / 7</span></div><div class="camel-tray">@for(int i=0;i<7;i++){<div class="tray-slot">@if(i<Model.Tray.Count){<span @key="Model.Tray[i].Id"><TileArt Kind="Model.Tray[i].Kind"/></span>}</div>}</div>@if(Model.Side.Count>0){<div class="side-storage"><small>المخزن الجانبي • اضغط حتى ترجع القطعة</small><div>@foreach(var tile in Model.Side){var t=tile;<button data-side-tile="@t.Id" disabled="@Model.Lost" @onclick="()=>Pick(t.Id,true)"><TileArt Kind="t.Kind"/></button>}</div></div>}</div><aside class="game-aside"><div class="mini-label">KEEP IT CLEAR</div><h3>ثلاثة.. وتختفي</h3><p>اختار القطع المكشوفة. كل3من نفس الرمز تختفي، لكن امتلاء الخانة7ينهي الجولة.</p><div class="helper-buttons"><button class="secondary" data-action="camel-undo" disabled="@(Model.UndoLeft==0||Model.Lost)" @onclick="Undo">↶ تراجع <span>@Model.UndoLeft</span></button><button class="secondary" data-action="camel-store" disabled="@(Model.StoreLeft==0||Model.Lost||Model.Side.Count>0||Model.Tray.Count==0)" @onclick="Store">⇧ نقل3للمخزن <span>@Model.StoreLeft</span></button><button class="secondary" data-action="camel-shuffle" disabled="@(Model.ShuffleLeft==0||Model.Lost||Model.Tiles.Count<2)" @onclick="Shuffle">⤨ خلط القطع <span>@Model.ShuffleLeft</span></button></div><span class="small-note">المساعدات تجريبية ومجانية.</span></aside></div><div class="status-line" role="status">@Status</div>
@code {
    readonly CamelModel Model=new();string Status="اختار قطعة مكشوفة وابدأ أول تطابق.";
    protected override void OnInitialized()=>Model.Reset();
    static string TileStyle(Tile t)=>FormattableString.Invariant($"left:{(t.X+.4)/14*100:0.###}%;top:{(t.Y+.4)/10*100:0.###}%;z-index:{t.Z+1};");
    void Pick(int id,bool side=false){if(Model.Pick(id,side))Status=Model.Lost?"امتلأت الخانة.. جرّب لوح جديد!":Model.Won?"كفو! اكتملت المعاينة.":$"طابقت {Model.Matched} قطعة • رتّب اختيارك الجاي.";}
    void Reset(){Model.Reset();Status="لوح جديد، وفرصة جديدة.";}
    void Undo(){Status=Model.Undo()?"رجّعنا آخر قطعة." : "التراجع متاح لآخر اختيار غير مطابق فقط.";}
    void Store(){if(Model.Store())Status="نقلنا القطع للمخزن. تگدر ترجعها بالضغط.";}
    void Shuffle(){if(Model.Shuffle())Status="خلطنا الرموز، وعدد كل نوع محفوظ.";}
}
