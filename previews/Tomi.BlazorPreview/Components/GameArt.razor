case "camel":
<rect x="27" y="39" width="47" height="52" rx="9" fill="#b9a16b"/><rect x="27" y="33" width="47" height="52" rx="9" fill="#fff0ce"/><rect x="85" y="39" width="47" height="52" rx="9" fill="#b9a16b"/><rect x="85" y="33" width="47" height="52" rx="9" fill="#fff0ce"/><rect x="56" y="16" width="48" height="56" rx="9" fill="#d7ba7a"/><rect x="56" y="10" width="48" height="56" rx="9" fill="#fff7df"/><path d="M66 47h29V35l-6-5-4 6-6-7-6 9h-7Zm4 0v8m18-8v8m7-20V23h7" stroke="#c18c42" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="m40 61 10-15 8 5-11 14Z" fill="#ed8b55"/><path d="m101 59 8-12 9 5-11 12Z" fill="#67ac7d"/>break;
default:
<circle cx="80" cy="61" r="47" fill="#977344"/><circle cx="80" cy="56" r="47" fill="#f3d798"/>
@for(int i=0;i<8;i++){double a=(i*45-90)*Math.PI/180,b=((i+1)*45-90)*Math.PI/180;string[] colors=["#e6657d","#eac365","#63b991","#65aaca","#aa8acc","#df9670","#9db968","#c67b9d"];<path d="@FormattableString.Invariant($"M80 56 L{80+40*Math.Cos(a)} {56+40*Math.Sin(a)} A40 40 0 0 1 {80+40*Math.Cos(b)} {56+40*Math.Sin(b)} Z")" fill="@colors[i]"/>}
<circle cx="80" cy="56" r="12" fill="#244847" stroke="#ffe9ad" stroke-width="3"/><path d="m70 6 10 20L90 6Z" fill="#fff1c0"/>break;
