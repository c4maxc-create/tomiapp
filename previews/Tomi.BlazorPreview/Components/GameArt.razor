<g transform="rotate(15 103 60)"><rect x="75" y="20" width="54" height="82" rx="9" fill="#bea77d"/><rect x="75" y="16" width="54" height="82" rx="9" fill="#fff3d9"/><rect x="79" y="20" width="46" height="74" rx="6" fill="#477fe0"/><ellipse cx="102" cy="57" rx="17" ry="28" transform="rotate(25 102 57)" stroke="white" stroke-width="2"/><text x="102" y="69" fill="white" text-anchor="middle" font-size="36" font-weight="900">8</text></g>break;
case "snakes":
<rect x="29" y="20" width="102" height="82" rx="13" fill="#8f633d"/><rect x="29" y="15" width="102" height="82" rx="13" fill="#ead3a4"/>
@for(int y=0;y<4;y++){for(int x=0;x<5;x++){<rect x="@(36+x*18)" y="@(22+y*17)" width="17" height="16" rx="2" fill="@((x+y)%2==0?"#45847a":"#8ab58d")"/>}}
<path d="M48 79 96 32M57 88 105 41M55 74 64 83M66 63 75 72M77 52 86 61M88 41 97 50" stroke="#ffe7a0" stroke-width="4" stroke-linecap="round"/><path d="M113 41C77 34 126 83 94 83" stroke="#e95e76" stroke-width="8" stroke-linecap="round"/><circle cx="114" cy="39" r="6" fill="#f78b9d"/><circle cx="116" cy="38" r="1.5" fill="#302b42"/>break;
case "jackaroo":
<circle cx="80" cy="61" r="47" fill="#87603a"/><circle cx="80" cy="56" r="47" fill="#e2bd7d"/><circle cx="80" cy="56" r="39" stroke="#b18449" stroke-width="2"/>
@for(int i=0;i<24;i++){double a=i*Math.PI/12;<circle cx="@(80+33*Math.Cos(a))" cy="@(56+33*Math.Sin(a))" r="2.3" fill="#8d663d"/>}
