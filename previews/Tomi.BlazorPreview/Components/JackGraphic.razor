<svg viewBox="0 0 100 100" aria-label="لوح جاكارو"><circle cx="50" cy="50" r="49" fill="#714c2e"/><circle cx="50" cy="50" r="47.5" fill="#d9b777"/><circle cx="50" cy="50" r="45.5" fill="#edcf94" stroke="#ad8244" stroke-width=".3"/>@for(int n=0;n<64;n++){var p=JackModel.Cell(0,n);<circle cx="@p.X" cy="@p.Y" r="1.1" fill="@(n%16==0?SeatColors[n/16]:"#89623e")"/>}@for(int seat=0;seat<4;seat++){var angle=Math.PI/2+seat*Math.PI/2;for(int n=0;n<4;n++){double r=13+n*4.5;<circle cx="@(50+Math.Cos(angle)*r)" cy="@(50+Math.Sin(angle)*r)" r="1.4" fill="@SeatColors[seat]"/>}}<g><text x="50" y="49" text-anchor="middle" class="jack-logo">TOMI</text><text x="50" y="54" text-anchor="middle" class="jack-sub">JACKAROO</text></g></svg>
@code{static readonly string[] SeatColors=["#ef6173","#5fa8e8","#efbe55","#51b88d"];}
