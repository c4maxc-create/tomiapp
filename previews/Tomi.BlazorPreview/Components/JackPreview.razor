@inherits PreviewComponent
<div class="game-heading"><div><small>YOUR TEAM, YOUR TABLE</small><h2>جاكارو <span>• حركة الحجر والورقة</span></h2></div><button class="secondary" disabled="@Busy" data-action="jack-reset" @onclick="Reset">↻ ترتيب جديد</button></div>
<div class="board-layout"><div class="jack-board"><svg viewBox="0 0 100 100" aria-label="لوح جاكارو"><circle cx="50" cy="50" r="49" fill="#714c2e"/><circle cx="50" cy="50" r="47.5" fill="#d9b777"/><circle cx="50" cy="50" r="45.5" fill="#edcf94" stroke="#ad8244" stroke-width=".3"/>@for(int n=0;n<64;n++){var p=JackModel.Cell(0,n);<circle cx="@p.X" cy="@p.Y" r="1.1" fill="@(n%16==0?SeatColors[n/16]:"#89623e")"/>}@for(int seat=0;seat<4;seat++){var angle=Math.PI/2+seat*Math.PI/2;for(int n=0;n<4;n++){double r=13+n*4.5;<circle cx="@(50+Math.Cos(angle)*r)" cy="@(50+Math.Sin(angle)*r)" r="1.4" fill="@SeatColors[seat]"/>}}<g><text x="50" y="49" text-anchor="middle" class="jack-logo">TOMI</text><text x="50" y="54" text-anchor="middle" class="jack-sub">JACKAROO</text></g></svg>
@for(int pawn=0;pawn<4;pawn++){var index=pawn;<button class="jack-pawn own @(Model.Selected==index?"chosen":"")" data-pawn="@index" style="@PawnStyle(0,Model.Positions[index])" disabled="@Busy" aria-label="حجر @(index+1)" aria-pressed="@(Model.Selected==index)" @onclick="()=>Model.Selected=index">@(index+1)</button>}
@for(int seat=1;seat<4;seat++){for(int pawn=0;pawn<4;pawn++){<div class="jack-pawn other" style="@($"{PawnStyle(seat,7+pawn*5)}background:{SeatColors[seat]}")">@(pawn+1)</div>}}
</div><aside class="game-aside"><div class="mini-label">CHOOSE YOUR MOVE</div><h3>الحجر <span data-testid="jack-selected">@(Model.Selected+1)</span></h3><p>اضغط حجرًا من أحجارك الحمراء، وبعدين اختار ورقة لتجربة الحركة.</p><div class="jack-cards">@foreach(var action in Actions){var value=action.Id;<button class="sample-card" data-jack-action="@value" disabled="@Busy" @onclick="()=>Move(value)"><strong>@action.Symbol</strong><span>@action.Label</span></button>}</div></aside></div>
<div class="status-line" role="status">@Status</div><p class="disclaimer">عينات حركة محلية؛ لا تمثل مباراة جاكارو كاملة أو قواعد السيرفر الحية.</p>
@code {
    readonly JackModel Model=new();string Status="اختار حجرًا.. وشوف الورقة شلون تحركه.";
    static readonly string[] SeatColors=["#ef6173","#5fa8e8","#efbe55","#51b88d"];
    static readonly (string Id,string Symbol,string Label)[] Actions=[("ace","A","خطوة"),("back","4","أربع للخلف"),("split","7","تقسيم3و4"),("swap","J","تبديل"),("king","K","13خطوة")];
    static string PawnStyle(int seat,int pos){var p=JackModel.Cell(seat,pos);return FormattableString.Invariant($"left:{p.X:0.###}%;top:{p.Y:0.###}%;");}
    void Reset(){Model.Reset();Status="رتبنا الأحجار من جديد.";}
    async Task Walk(int pawn,int steps){for(int i=0;i<Math.Abs(steps);i++){Model.Step(pawn,steps<0?-1:1);StateHasChanged();await Pause(105);}}
    Task Move(string action)=>Animate(async()=>{int pawn=Model.Selected;if(action=="swap"){Model.Swap();StateHasChanged();await Pause(450);}else if(action=="split"){await Walk(pawn,3);await Walk((pawn+1)%4,4);}else await Walk(pawn,action=="back"?-4:action=="king"?13:1);Status="تمت حركة المعاينة • نتيجة اللعب الحقيقي تبقى بالسيرفر.";});
}
