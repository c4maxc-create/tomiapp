<svg viewBox="0 0 100 100" aria-label="لوحة السلم والأفعى100خانة">@for(int n=1;n<=100;n++){var cell=SnakeModel.Cell(n);<g><rect x="@(cell.X-5)" y="@(cell.Y-5)" width="10" height="10" fill="@(n%2==0?"#274f45":"#34705d")"/><text x="@cell.X" y="@(cell.Y+.8)" text-anchor="middle" class="cell-number">@n</text></g>}@foreach(var jump in SnakeModel.Jumps){var a=SnakeModel.Cell(jump.Key);var b=SnakeModel.Cell(jump.Value);<g>@if(jump.Value>jump.Key){double dx=b.X-a.X,dy=b.Y-a.Y,len=Math.Sqrt(dx*dx+dy*dy),ox=-dy/len*1.1,oy=dx/len*1.1;<path d="@Rail(a,b,ox,oy)" fill="none" stroke="#f9d987" stroke-width=".65" stroke-linecap="round"/><path d="@Rail(a,b,-ox,-oy)" fill="none" stroke="#f9d987" stroke-width=".65" stroke-linecap="round"/>@for(int rung=0;rung<=7;rung++){double t=rung/7d,x=a.X+dx*t,y=a.Y+dy*t;<line x1="@(x-ox)" y1="@(y-oy)" x2="@(x+ox)" y2="@(y+oy)" stroke="#ffe5a3" stroke-width=".55"/>}}else{<path d="@Path(a,b)" class="snake-path"/><circle cx="@a.X" cy="@a.Y" r="1.6" fill="#f8a0aa"/><circle cx="@(a.X-.5)" cy="@(a.Y-.3)" r=".25" fill="#4e3044"/><circle cx="@(a.X+.5)" cy="@(a.Y-.3)" r=".25" fill="#4e3044"/>}</g>}</svg>
@code{
static string Rail((double X,double Y)a,(double X,double Y)b,double ox,double oy)=>FormattableString.Invariant($"M {a.X+ox} {a.Y+oy} L {b.X+ox} {b.Y+oy}");
static string Path((double X,double Y)a,(double X,double Y)b)=>FormattableString.Invariant($"M {a.X} {a.Y} Q {(a.X+b.X)/2+4} {(a.Y+b.Y)/2} {b.X} {b.Y}");
}
