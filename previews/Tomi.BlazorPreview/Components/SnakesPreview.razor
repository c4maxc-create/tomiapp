@inherits PreviewComponent
<div class="game-heading"><div><small>ONE ROLL, A NEW STORY</small><h2>السلم والأفعى</h2></div><button class="secondary" disabled="@Busy" data-action="snakes-reset" @onclick="Reset">↻ من البداية</button></div>
<div class="board-layout snakes-layout"><div class="snakes-board"><svg viewBox="0 0 100 100" aria-label="لوحة السلم والأفعى100خانة">@for(int n=1;n<=100;n++){var cell=SnakeModel.Cell(n);<g><rect x="@(cell.X-5)" y="@(cell.Y-5)" width="10" height="10" fill="@(n%2==0?"#274f45":"#34705d")"/><text x="@cell.X" y="@(cell.Y+.8)" text-anchor="middle" class="cell-number">@n</text></g>}@foreach(var jump in SnakeModel.Jumps){var a=SnakeModel.Cell(jump.Key);var b=SnakeModel.Cell(jump.Value);<g><path d="@Path(a,b)" class="@(jump.Value>jump.Key?"ladder-path":"snake-path")"/></g>}</svg><div class="snake-pawn" data-testid="snake-pawn" style="@PositionStyle"><span>أنت</span></div></div><aside class="game-aside"><div class="mini-label">YOUR NEXT MOVE</div><div class="dice" data-testid="dice">@Dice</div><h3>خانة <span data-testid="snake-position">@Model.Position</span> من100</h3><p>ارمِ النرد وتحرك خطوة بخطوة. السلم يرفعك والأفعى تنزلك.</p><button class="primary" data-action="snakes-roll" disabled="@(Busy||Model.Position==100)" @onclick="Roll">⚄ ارمِ النرد</button><div class="legend"><span>↗ سلم</span><span>↘ أفعى</span></div></aside></div>
<div class="status-line" role="status">@Status</div>
@code {
    readonly SnakeModel Model=new();int Dice=1;string Status="من أول خانة.. لحد100. جرب حظ النرد.";
    string PositionStyle{get{var p=SnakeModel.Cell(Model.Position);return FormattableString.Invariant($"left:{p.X}%;top:{p.Y}%;");}}
    static string Path((double X,double Y)a,(double X,double Y)b)=>FormattableString.Invariant($"M {a.X} {a.Y} Q {(a.X+b.X)/2+4} {(a.Y+b.Y)/2} {b.X} {b.Y}");
    void Reset(){Model.Reset();Dice=1;Status="رجعنا للبداية. نبدأ جولة جديدة؟";}
    Task Roll()=>Animate(async()=>{Dice=Random.Shared.Next(1,7);if(!Model.CanRoll(Dice)){Status="تحتاج الرقم بالضبط حتى توصل100.";return;}for(int i=0;i<Dice;i++){Model.Step();StateHasChanged();await Pause(170);}int before=Model.Position;Model.Jump();if(before!=Model.Position){Status=Model.Position>before?"صعود جميل!":"الأفعى غيرت طريقك!";StateHasChanged();await Pause(500);}else Status="وصلت للخانة "+Model.Position;if(Model.Position==100)Status="وصلت100! جرّب جولة جديدة.";});
}
