@inherits PreviewComponent
<div class="game-heading"><div><small>JUST ONE MORE SPIN</small><h2>الروليت <span>• إحساس الدوران</span></h2></div><span class="safe-badge">معاينة بدون رهان</span></div>
<div class="board-layout wheel-layout"><div class="wheel-stage"><div class="wheel-pointer"></div><div class="wheel" style="@WheelStyle" data-testid="wheel">@for(int i=0;i<8;i++){double a=(22.5+i*45)*Math.PI/180;<div class="wheel-item" style="@ItemStyle(a)"><span>@WheelModel.Icons[i]</span></div>}<div class="wheel-center">T<span>PLAY</span></div></div><div class="wheel-stand"></div></div><aside class="game-aside"><div class="mini-label">FEEL THE SPIN</div><h3>@(Finished?WheelModel.Names[Model.Result]:"لفّة على كيفك")</h3><p>جرّب التسارع والتباطؤ والتوقف على القطاع. النتيجة محلية للعرض فقط.</p><button class="primary" data-action="wheel-spin" disabled="@Busy" @onclick="Spin">✦ لفّ العجلة</button><div class="wheel-result" data-testid="wheel-result">@(Finished?WheelModel.Icons[Model.Result]:"✦")</div><span class="small-note">ماكو خصم أو أرباح أو تغيير بالرصيد.</span></aside></div><div class="status-line" role="status">@Status</div>
@code {
    readonly WheelModel Model=new();bool Finished;string Status="دوران تجريبي، بدون أي معاملة مالية.";
    string WheelStyle=>FormattableString.Invariant($"transform:rotate({Model.Rotation:0.##}deg);transition-duration:{(ReducedMotion ? .001 : 3.2/AnimationSpeed).ToString(System.Globalization.CultureInfo.InvariantCulture)}s;");
    static string ItemStyle(double a)=>FormattableString.Invariant($"left:{50+Math.Sin(a)*34:0.###}%;top:{50-Math.Cos(a)*34:0.###}%;");
    Task Spin()=>Animate(async()=>{Finished=false;Model.Spin(Random.Shared.Next(8));StateHasChanged();await Pause(3250);Finished=true;Status="توقفت على "+WheelModel.Names[Model.Result]+" • معاينة فقط.";});
}
