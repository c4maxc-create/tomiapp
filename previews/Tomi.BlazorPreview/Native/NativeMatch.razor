@inherits PreviewComponent
<div class="game-heading" data-table-sequence='@Match.Num("sequence")' data-motion-busy="@Busy.ToString().ToLowerInvariant()"><div><small>LIVE TABLE · SERVER STATE</small><h2>@Name</h2></div><span class="safe-badge">@TurnLabel</span></div>
<div class="live-players @(Kind=="uno"?"uno-summary":"")">@foreach(var p in Match.Get("players").Items()){<div class="live-player @(Match.Num("turn")==p.Num("seat")?"turn":"")"><span class="player-disc" style="@($"--seat:{Colors[p.Num("seat")%4]}")">@(p.Num("seat")+1)</span><div><b>@p.Get("user").Text("displayName",$"كمبيوتر {p.Num("seat")+1}")</b><small>@(p.Num("seat")==Match.Num("mySeat")?"أنت • ":"")@(Kind=="wheel"?p.Num("score")+" نقطة • "+p.Num("spins")+"/3":Kind=="snakes"?"خانة "+p.Num("position"):Kind=="camel"?p.Num("progress")+"٪":p.Num("cardCount")+" أوراق")</small></div></div>}</div>
@if(Match.Text("status")=="waiting"){
<div class="connection-panel"><GameArt Kind="@Kind"/><h3>اجمع أصدقاءك</h3><p>شارك الكود من قسم الألعاب</p><strong class="room-code">@Match.Text("code")</strong><div class="invite-actions"><button class="secondary" disabled="@(Session.Waiting)" @onclick='()=>Session.Send("copyCode")'>نسخ الكود</button><button class="secondary" disabled="@(Session.Waiting)" @onclick='()=>Session.Send("shareCode")'>مشاركة QR</button><button class="primary" data-live="invite" disabled="@(Session.Waiting)" @onclick='()=>Session.Send("invite")'>ادعُ صديقًا بالمحادثات</button></div><p>لاعبان على الأقل لبدء الجولة</p>@if(Match.Yes("host")){<button class="primary" data-live="start" disabled="@(!Session.CanAct||Match.Get("players").Items().Length<2)" @onclick='()=>Action("start")'>ابدأ الجولة</button>}</div>
}else if(Match.Text("status")=="cancelled"){<div class="control-guide"><h3>أُغلقت الطاولة</h3><p>ارجع للمجموعة لبدء جولة جديدة.</p><button class="secondary" @onclick='()=>Session.Send("closeTable")'>الرجوع للمجموعة</button></div>}
else{
@if(Match.Text("status")=="finished"){<div class="control-guide live-result"><h3>@ResultLabel</h3><p>الخبرة المكتسبة: @Match.Num("earnedXp") XP</p><button class="primary" data-live="result-close" @onclick='()=>Session.Send("closeTable")'>ارجع للمجموعة</button></div>}
@if(Kind=="uno"){
<div class="uno-arena live-uno"><div class="cloud c1"></div><div class="cloud c2"></div><div class="table-hud"><span><i></i> @TurnLabel</span><b>طاولة TOMI</b><span>@Match.Get("players").Items().Length مقاعد</span></div>
@for(int n=0;n<Opponents.Length;n++){var p=Opponents[n];<div data-seat='@p.Num("seat")' class="seat @(n==0?"north":n==1?"west":"east")"><div class="avatar @(n==0?"peach":n==1?"blue":"purple")">@(p.Num("seat")+1)</div><b>@p.Get("user").Text("displayName","كمبيوتر")</b><small>@p.Num("cardCount") أوراق</small><div class="mini-backs">▰▰▰</div></div>}
<div class="island"><div class="table-ring"><div class="table-felt"><span class="table-brand">TOMI<br/><small>CARD CLUB</small></span><span class="direction">@(Match.Num("direction",1)>0?"↻":"↺")</span><div class="piles"><button class="deck-button" data-live="uno-deck" disabled="@(Busy||!Session.CanAct||!Match.Yes("canDraw"))" @onclick='()=>Action("draw")'><PlayingCard Card="Top" FaceDown="true"/></button><div class="discard" @key="Top.Id"><PlayingCard Card="Top"/></div></div><span class="table-note">اللون الحالي: @ColorName(Match.Text("activeColor")) • رزمة @Match.Num("deckCount")</span></div></div></div>
@if(FlyingCard is not null){<div class="card-flight live-flight @FlightClass" style="@($"{FlightStyle};--flight-duration:{(FlightDuration/AnimationSpeed).ToString(System.Globalization.CultureInfo.InvariantCulture)}ms")" data-testid="live-card-flight" @key="FlightNumber"><PlayingCard Card="FlyingCard" FaceDown="FlightFaceDown"/></div>}
@if(MotionLabel!=""){<div class="motion-toast" role="status">@MotionLabel</div>}
<div class="you"><i></i> أنت <span>@Hand.Length أوراق</span></div>
<div class="live-hand" role="group" aria-label="أوراقك" tabindex="0" @onkeydown="KeyHand">@foreach(var card in Hand){var id=card.Id;<button @key="id" data-live-card="@id" style="@HandStyle(id)" class="hand-card @(Selected==id?"selected":"")" disabled="@(!(Session.MyTurn&&!Busy)||!Playable.Contains(id))" aria-pressed="@(Selected==id)" aria-label="@($"{ColorName(card.Color??"wild")} {card.Symbol}")" @onclick="()=>Selected=id"><PlayingCard Card="card"/></button>}</div>
<div class="selection-readout">@(Selected is null?"اختار ورقة مسموحة من يدك":"ورقتك جاهزة • "+Hand.FirstOrDefault(c=>c.Id==Selected)?.Symbol)</div>
<div class="uno-controls"><button class="secondary" data-live="uno-draw" disabled="@(Busy||!Session.CanAct||!Match.Yes("canDraw"))" @onclick='()=>Action("draw")'>＋ اسحب</button><button class="primary" data-live="uno-play" disabled="@(!(Session.MyTurn&&!Busy)||Selected is null||!Playable.Contains(Selected))" @onclick="Play">العب الورقة</button>@if(Match.Yes("canPass")){<button class="secondary" data-live="uno-pass" disabled="@(!Session.CanAct)" @onclick='()=>Action("pass")'>مرّر</button>}<button class="uno-button @(Announced?"announced":"")" aria-pressed="@Announced" disabled="@(!(Session.MyTurn&&!Busy))" @onclick="()=>Announced=!Announced">UNO!</button></div>
@if(ChooseColor){<div class="modal-shade" role="dialog" aria-modal="true" aria-label="اختيار اللون"><div class="color-dialog"><h3>اختار اللون التالي</h3><div class="color-options">@foreach(var color in CardColors){<button class="@color" aria-label="@ColorName(color)" @onclick="()=>SendCard(color)"></button>}</div><button class="secondary" @onclick="()=>ChooseColor=false">رجوع</button></div></div>}
</div>
}else if(Kind=="wheel"){
<div class="board-layout wheel-layout"><div class="wheel-stage"><div class="wheel-pointer"></div><div class="wheel" data-testid="free-wheel" style="@FormattableString.Invariant($"transform:rotate({FreeRotation}deg);transition-duration:{(ReducedMotion?0:2.5/AnimationSpeed)}s")">@for(int i=0;i<8;i++){double a=(22.5+i*45)*Math.PI/180;<div class="wheel-item" style="@FormattableString.Invariant($"left:{50+Math.Sin(a)*34}%;top:{50-Math.Cos(a)*34}%")"><span>@FreePoints[i]</span></div>}<div class="wheel-center">T<span>FREE</span></div></div><div class="wheel-stand"></div></div><aside class="game-aside"><small class="mini-label">FREE PLAY · NO COINS</small><h3>@TurnLabel</h3><p>ثلاث لفات لكل لاعب. صاحب أعلى مجموع يفوز. النقاط للتسلية ولا تغيّر رصيدك.</p><button class="primary" data-live="free-spin" disabled="@(!(Session.MyTurn&&!Busy))" @onclick='()=>Action("spin")'>لفّ العجلة</button><div class="wheel-result">@FreeResult</div></aside></div>
}else if(Kind=="snakes"){
<div class="board-layout"><div class="snakes-board @(Transporting?"transporting":"")"><SnakesGraphic/>@foreach(var p in Match.Get("players").Items().Where(p=>VisualPositions.GetValueOrDefault(p.Num("seat"),p.Num("position"))>0)){var pos=SnakeModel.Cell(VisualPositions.GetValueOrDefault(p.Num("seat"),p.Num("position")));<div class="snake-pawn" data-pawn-seat='@p.Num("seat")' data-position='@VisualPositions.GetValueOrDefault(p.Num("seat"),p.Num("position"))' style="@FormattableString.Invariant($"left:{pos.X+(p.Num("seat")%2-.5)*2}%;top:{pos.Y}%;background:{Colors[p.Num("seat")%4]}")"><span>@(p.Num("seat")+1)</span></div>}</div><aside class="game-aside"><div class="mini-label">YOUR NEXT MOVE</div><div class="dice @(Rolling?"rolling":"")">@(VisualDice??Match.Get("lastMove").Num("dice",1))</div><h3>@TurnLabel</h3><p>الرقم من الخادم. الوصول إلى 100 يحتاج الرقم بالضبط.</p><button class="primary" data-live="roll" disabled="@(!(Session.MyTurn&&!Busy))" @onclick='()=>Action("roll")'>ارمِ النرد</button></aside></div>
}else if(Kind=="jackaroo"){
<div class="board-layout"><div class="jack-board"><JackGraphic/>@if(JackFlying is not null){<div class="jack-card-placement" @key="FlightNumber"><PlayingCard Card="JackFlying"/></div>}@foreach(var p in Match.Get("players").Items()){var pawns=p.Get("pawns").Items();for(int i=0;i<pawns.Length;i++){int pawn=i,seat=p.Num("seat");var pos=PawnPoint(seat,VisualPawns.GetValueOrDefault((seat,i),pawns[i].TryNumber(-1)),i);<button class="jack-pawn @(seat==Match.Num("controlledSeat",Match.Num("mySeat"))?"own":"other") @(SelectedPawn==pawn&&seat==Match.Num("controlledSeat",Match.Num("mySeat"))?"chosen":"")" disabled="@(!(Session.MyTurn&&!Busy)||seat!=Match.Num("controlledSeat",Match.Num("mySeat")))" aria-label="حجر @(pawn+1) للاعب @(seat+1)" @onclick="()=>SelectPawn(pawn)" style="@FormattableString.Invariant($"left:{pos.X}%;top:{pos.Y}%;background:{Colors[seat%4]}")">@(pawn+1)</button>}}</div><aside class="game-aside"><div class="mini-label">CHOOSE YOUR MOVE</div><h3>أوراقك الحقيقية</h3><p>اختار ورقة ثم حركة من الخيارات المسموحة. @(Match.Num("controlledSeat")==Match.Num("mySeat")?"":"أنت تساعد شريكك الآن.")</p><div class="jack-cards">@foreach(var c in Match.Get("hand").Items()){var id=c.Text("id");<button class="sample-card @(SelectedJack==id?"selected":"")" data-live-jack="@id" disabled="@(!(Session.MyTurn&&!Busy)||!Choices.Any(x=>x.Text("cardId")==id))" @onclick="()=>SelectJackCard(id)"><strong>@c.Text("value")</strong><span>@Suit(c.Text("suit"))</span></button>}</div><button class="secondary" @onclick="()=>SelectPawn(null)">@(SelectedPawn is null?"كل الأحجار":"حجر "+(SelectedPawn+1)+" • عرض الكل")</button><div class="legal-choices">@foreach(var c in FilteredChoices.Take(ChoiceLimit)){var choice=c.Text("id");<button class="secondary" data-live-choice="@choice" disabled="@(!(Session.MyTurn&&!Busy))" @onclick="()=>Choose(choice)">@c.Text("label")</button>}</div>@if(FilteredChoices.Length>ChoiceLimit){<button class="secondary" @onclick="()=>ChoiceLimit+=20">عرض حركات أكثر</button>}</aside></div>
}else if(Kind=="camel"){
<div class="board-layout camel-layout"><div class="camel-main"><div class="camel-topline"><span>طلب الفريق: @Match.Get("orders").Num("count") / @Match.Get("orders").Num("required",2)</span><span>@Match.Get("tiles").Items().Length قطعة متبقية</span></div><div class="camel-board">@if(FlyingTile.Exists()){<div class="tile-transfer" style="@TileStyle(FlyingTile)" @key="FlightNumber"><TileArt Kind='FlyingTile.Num("kind")'/></div>}@foreach(var tile in Match.Get("tiles").Items().OrderBy(t=>t.Num("z"))){var id=tile.Text("id");bool free=Choices.Any(x=>x.Text("id")==id);<button class="match-tile @(free?"free":"covered") @(FlyingTile.Text("id")==id?"tile-source-hidden":"")" data-live-tile="@id" disabled="@(!(Session.MyTurn&&!Busy)||!free)" style="@TileStyle(tile)" aria-label="قطعة @tile.Num("kind")" @onclick="()=>Choose(id)"><TileArt Kind='tile.Num("kind")'/></button>}</div><div class="tray-heading"><b>خانة التجميع</b><span>@Match.Get("tray").Items().Length / 7</span></div><div class="camel-tray @(TrayBurst?"tray-burst":"")">@for(int i=0;i<7;i++){<div class="tray-slot">@if(i<Match.Get("tray").Items().Length){<TileArt Kind='Match.Get("tray").Items()[i].Num("kind")'/>}</div>}</div>@if(Match.Get("side").Items().Length>0){<div class="side-storage"><small>المخزن الجانبي</small><div>@foreach(var tile in Match.Get("side").Items()){var choice="side:"+tile.Text("id");<button data-live-side="@choice" disabled="@(!(Session.MyTurn&&!Busy))" @onclick="()=>Choose(choice)"><TileArt Kind='tile.Num("kind")'/></button>}</div></div>}</div><aside class="game-aside"><div class="mini-label">KEEP IT CLEAR</div><h3>ثلاثة.. وتختفي</h3><p>كل ثلاث قطع متشابهة تختفي. انتبه للخانات السبع وتعاون مع فريقك.</p><div class="helper-buttons">@foreach(var tool in Tools){var id="tool:"+tool.Id;<button class="secondary" data-live-tool="@tool.Id" disabled="@(!(Session.MyTurn&&!Busy)||!Choices.Any(x=>x.Text("id")==id))" @onclick="()=>Choose(id)">@tool.Name <span>@Match.Get("tools").Num(tool.Id)</span></button>}</div></aside></div>
}
}
<div class="status-line" role="status">@(Busy?MotionLabel:Session.Waiting||Session.State.Yes("busy")?"ننتظر تأكيد الخادم…":TurnLabel)</div>
@code{
    [Parameter,EditorRequired]public NativeSession Session{get;set;}=default!;
    System.Text.Json.JsonElement Match=>Displayed.Exists()?Displayed:Session.Match;
    string Kind=>Match.Text("kind");
    string Name=>Kind switch{"uno"=>"أونو • أوراق تومي","snakes"=>"السلم والأفعى","jackaroo"=>"جاكارو","camel"=>"الجمل المجنون","wheel"=>"دولاب النقاط المجاني",_=>"TOMI"};
    string TurnLabel=>Match.Text("status") switch{"waiting"=>"بانتظار الأصدقاء","finished"=>"انتهت الجولة","cancelled"=>"أُغلقت الطاولة",_=>Kind=="camel"?"فريقك يقدر يتحرك":Match.Num("turn")==Match.Num("mySeat")?"دورك الآن":"دور اللاعب "+(Match.Num("turn")+1)};
    string ResultLabel=>Kind=="camel"?(Match.Get("result").Text("reason")=="team_clear"?"فريقك أكمل اللوح!":"انتهت جولة الفريق"):Kind=="jackaroo"?"الفريق الفائز: "+(Match.Get("result").Num("winnerSeat")%2+1):"الفائز: اللاعب "+(Match.Get("result").Num("winnerSeat")+1);
    static readonly string[] Colors=["#ef6173","#5fa8e8","#efbe55","#51b88d"],CardColors=["red","blue","green","yellow"];
    static readonly (string Id,string Name)[] Tools=[("undo","تراجع"),("remove","نقل للمخزن"),("shuffle","خلط القطع")];
    static readonly int[] FreePoints=[2,3,5,8,13,21,34,55];
    double FreeRotation;string FreeResult="";
    int? SelectedPawn;int ChoiceLimit=20;
    System.Text.Json.JsonElement[] FilteredChoices=>Choices.Where(x=>x.Text("cardId")==SelectedJack&&(SelectedPawn is null||x.Yes("discard")||x.Num("pawn",-1)==SelectedPawn||x.Get("steps").Items().Any(step=>step.Num("pawn",-1)==SelectedPawn))).ToArray();
    void SelectPawn(int? pawn){SelectedPawn=pawn;ChoiceLimit=20;}
    void SelectJackCard(string id){SelectedJack=id;ChoiceLimit=20;}
    string? Selected,SelectedJack;bool Announced,ChooseColor;
    System.Text.Json.JsonElement Displayed,FlyingTile;
    readonly Queue<System.Text.Json.JsonElement> Snapshots=new();
    readonly Dictionary<int,int> VisualPositions=new();
    readonly Dictionary<(int,int),int> VisualPawns=new();
    Card[]? VisualHand;Card? VisualTop,FlyingCard,JackFlying;
    [Microsoft.AspNetCore.Components.Inject]public Microsoft.JSInterop.IJSRuntime JS{get;set;}=default!;
    record Geometry(double X,double Y,double Dx,double Dy);
    string FlightStyle="";
    async Task Measure(int seat,string cardId,bool draw){
        try{var point=await Microsoft.JSInterop.JSRuntimeExtensions.InvokeAsync<Geometry?>(JS,"tomiNative.measureMove",new object?[]{seat,Match.Num("mySeat"),cardId,draw});
        if(point is not null){FlightClass="measured-flight";FlightStyle=FormattableString.Invariant($"left:{point.X}px;top:{point.Y}px;--move-x:{point.Dx}px;--move-y:{point.Dy}px");return;}}catch(Microsoft.JSInterop.JSException){}
        FlightStyle="";
    }
    string MotionLabel="",FlightClass="";bool FlightFaceDown,Rolling,TrayBurst,Draining,DealPending,Transporting;
    int LastQueued=-1,VisualSequence,FlightNumber,FlightDuration=520;int? VisualDice;
    protected override void OnParametersSet(){
        var next=Session.Match;if(!next.Exists())return;
        if(!Displayed.Exists()){ApplyVisual(next);LastQueued=next.Num("revision");ReconcileSelection();if(next.Text("kind")=="uno"&&next.Num("sequence")==0&&Hand.Length>0){DealPending=true;_ = Drain();}return;}
        if(next.Num("revision")>LastQueued){LastQueued=next.Num("revision");Snapshots.Enqueue(next.Clone());_ = Drain();}
        ReconcileSelection();
    }
    void ApplyVisual(System.Text.Json.JsonElement value){
        Displayed=value.Clone();VisualTop=null;VisualHand=null;VisualSequence=value.Num("sequence");
        foreach(var p in value.Get("players").Items()){
            VisualPositions[p.Num("seat")]=p.Num("position");var pawns=p.Get("pawns").Items();
            for(int i=0;i<pawns.Length;i++)VisualPawns[(p.Num("seat"),i)]=pawns[i].TryNumber(-1);
        }
    }
    async Task Frame(int delay){if(Disposed)return;StateHasChanged();await Pause(delay);}
    async Task Drain(){
        if(Draining||Disposed)return;Draining=true;
        try{await Animate(async()=>{
            if(DealPending){DealPending=false;var cards=Hand;VisualHand=[];for(int i=0;i<cards.Length;i++){VisualHand=cards.Take(i+1).ToArray();await Frame(85);}VisualHand=null;}
            while(Snapshots.Count>0&&!Disposed){
                var next=Snapshots.Dequeue();var history=next.Get("history").Items();
                var events=history.Select((e,i)=>(Event:e,Seq:e.Num("sequence",next.Num("sequence")-i))).Where(x=>x.Seq>VisualSequence).OrderBy(x=>x.Seq).ToArray();
                foreach(var step in events){
                    if(next.Text("kind")=="uno")await UnoMotion(step.Event);
                    else if(next.Text("kind")=="snakes")await SnakeMotion(step.Event);
                    else if(next.Text("kind")=="jackaroo")await JackMotion(step.Event);
                    else if(next.Text("kind")=="wheel")await FreeSpinMotion(step.Event);
                    VisualSequence=step.Seq;
                }
                if(next.Text("kind")=="camel")await CamelMotion(next);
                ApplyVisual(next);MotionLabel="";ReconcileSelection();if(!Disposed)StateHasChanged();
            }
        });}finally{Draining=false;FlyingCard=null;FlyingTile=default;}
    }
    async Task UnoMotion(System.Text.Json.JsonElement e){
        int seat=e.Num("seat");bool own=seat==Match.Num("mySeat");
        if(e.Text("type")=="play"&&e.Get("card").Exists()){
            FlyingCard=CardFrom(e.Get("card"));FlightFaceDown=false;FlightDuration=540;FlightClass=own?"from-you":"from-opponent";FlightNumber++;await Measure(seat,e.Get("card").Text("id"),false);
            MotionLabel=own?"ورقتك على الطاولة":"اللاعب "+(seat+1)+" يلعب ورقة";
            await Frame(540);VisualTop=FlyingCard;FlyingCard=null;
            if(own)VisualHand=Hand.Where(c=>c.Id!=e.Get("card").Text("id")).ToArray();
            var value=e.Get("card").Text("value");
            if(value is "skip" or "reverse" or "draw2" or "wild4"){
                MotionLabel=value switch{"skip"=>"تخطي الدور","reverse"=>"عكس الاتجاه","draw2"=>"سحب ورقتين",_=>"سحب أربع أوراق"};await Frame(260);
            }
        }else if(e.Text("type")=="draw"){
            FlyingCard=new("draw",null,"");FlightFaceDown=true;FlightClass=own?"to-you":"to-opponent";FlightDuration=440;FlightNumber++;await Measure(seat,"",true);MotionLabel="اللاعب "+(seat+1)+" يسحب ورقة";await Frame(440);FlyingCard=null;
        }
    }
    async Task SnakeMotion(System.Text.Json.JsonElement e){
        if(e.Text("type")!="roll")return;
        int seat=e.Num("seat");Rolling=true;VisualDice=e.Num("dice",1);MotionLabel="نرد اللاعب "+(seat+1)+": "+VisualDice;await Frame(260);Rolling=false;
        foreach(var step in e.Get("steps").Items()){VisualPositions[seat]=step.TryNumber();await Frame(150);}
        if(e.Num("to")!=e.Num("landing")){
            MotionLabel=e.Text("transport")=="ladder"?"صعود بالسلم":"نزول مع الأفعى";
            Transporting=true;VisualPositions[seat]=e.Num("to");await Frame(620);Transporting=false;
        }else if(e.Yes("overshoot")){MotionLabel="تحتاج الرقم بالضبط";await Frame(240);}
    }
    async Task JackMotion(System.Text.Json.JsonElement e){
        var moves=e.Get("movements").Items();MotionLabel=e.Text("label","حركة أحجار جاكارو");
        if(e.Get("card").Exists()){JackFlying=CardFrom(e.Get("card"));FlightNumber++;await Frame(360);JackFlying=null;}
        foreach(var move in moves){int seat=move.Num("seat"),pawn=move.Num("pawn"),from=move.Num("from"),to=move.Num("to"),delta=move.Num("delta");
            if(from>=0&&to>=0&&delta!=0){int current=from;for(int i=0;i<Math.Abs(delta);i++){current=delta<0?(current+63)%64:current+1;VisualPawns[(seat,pawn)]=current;await Frame(95);}}
            else{VisualPawns[(seat,pawn)]=to;await Frame(470);}
        }
    }
    async Task FreeSpinMotion(System.Text.Json.JsonElement e){
        if(e.Text("type")!="spin")return;
        double target=(360-(22.5+45*e.Num("slot")))%360;
        FreeRotation+=1440+(target-FreeRotation%360+360)%360;MotionLabel="تدور العجلة…";FreeResult="";await Frame(2550);FreeResult="+"+e.Num("points")+" نقطة";
    }
    async Task CamelMotion(System.Text.Json.JsonElement next){
        var removed=Match.Get("tiles").Items().Where(t=>!next.Get("tiles").Items().Any(n=>n.Text("id")==t.Text("id"))).ToArray();
        if(removed.Length==1){FlyingTile=removed[0];FlightNumber++;MotionLabel="قطعة إلى خانة التجميع";await Frame(420);FlyingTile=default;}
        if(next.Get("tray").Items().Length<Match.Get("tray").Items().Length&&removed.Length>0){TrayBurst=true;MotionLabel="تطابق ثلاثة!";await Frame(250);TrayBurst=false;}
    }

    Card[] Hand=>VisualHand??Match.Get("hand").Items().Select(CardFrom).ToArray();
    string HandStyle(string id){var cards=Hand;int i=Array.FindIndex(cards,c=>c.Id==id);double offset=i-(cards.Length-1)/2d;return FormattableString.Invariant($"--hand-angle:{Math.Clamp(offset,-6,6)*3.2}deg;--hand-arc:{Math.Min(Math.Abs(offset)*2,12)}px");}
    Card Top=>VisualTop??CardFrom(Match.Get("topCard"));
    static Card CardFrom(System.Text.Json.JsonElement c)=>new(c.Text("id"),c.Text("color") is var color&&color!=""?color:null,c.Text("value"));
    HashSet<string> Playable=>Match.Get("playableCardIds").Items().Select(x=>x.GetString()!).ToHashSet();
    System.Text.Json.JsonElement[] Opponents=>Match.Get("players").Items().Where(p=>p.Num("seat")!=Match.Num("mySeat")).ToArray();
    System.Text.Json.JsonElement[] Choices=>Match.Get("choices").Items();
    void ReconcileSelection(){if(!Hand.Any(c=>c.Id==Selected)||!Playable.Contains(Selected??"")){Selected=null;ChooseColor=false;}if(!(Session.MyTurn&&!Busy))ChooseColor=false;}
    static string ColorName(string color)=>color switch{"red"=>"أحمر","blue"=>"أزرق","green"=>"أخضر","yellow"=>"أصفر",_=>"متعدد الألوان"};
    static string Suit(string suit)=>suit switch{"hearts"=>"♥","diamonds"=>"♦","clubs"=>"♣",_=>"♠"};
    Task Action(string type)=>Session.Send("action",new{type});
    Task Choose(string choice)=>Session.Send("choice",new{choice});
    async Task KeyHand(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e){
        if(!(Session.MyTurn&&!Busy)||ChooseColor)return;
        var allowed=Hand.Where(c=>Playable.Contains(c.Id)).ToArray();
        if(e.Key is "ArrowLeft" or "ArrowRight"&&allowed.Length>0){int at=Array.FindIndex(allowed,c=>c.Id==Selected);Selected=allowed[(at+(e.Key=="ArrowLeft"?1:-1)+allowed.Length)%allowed.Length].Id;}
        else if(e.Key=="Enter")await Play();else if(e.Key is "d" or "D"&&Match.Yes("canDraw"))await Action("draw");else if(e.Key=="Escape")Selected=null;
    }
    async Task Play(){var card=Hand.FirstOrDefault(c=>c.Id==Selected);if(card is null||!(Session.MyTurn&&!Busy))return;if(card.Color is null){ChooseColor=true;return;}await SendCard(null);}
    async Task SendCard(string? color){ChooseColor=false;await Session.Send("action",new{type="play",cardId=Selected,color,uno=Announced});Selected=null;Announced=false;}
    static string Line((double X,double Y)a,(double X,double Y)b)=>FormattableString.Invariant($"M{a.X} {a.Y} Q{(a.X+b.X)/2+4} {(a.Y+b.Y)/2} {b.X} {b.Y}");
    static string TileStyle(System.Text.Json.JsonElement t)=>FormattableString.Invariant($"left:{(t.Num("x")+.4)/14*100}%;top:{(t.Num("y")+.4)/10*100}%;z-index:{t.Num("z")+1}");
    static (double X,double Y) PawnPoint(int seat,int pos,int pawn){double a=Math.PI/2+seat*Math.PI/2;if(pos>=64){double r=13+4.5*(pos-64);return(50+Math.Cos(a)*r,50+Math.Sin(a)*r);}if(pos<0){a=Math.PI*.75+seat*Math.PI/2;return(50+Math.Cos(a)*35+(pawn%2)*4.5,50+Math.Sin(a)*35+(pawn/2)*4.5);}return JackModel.Cell(seat,pos);}
}
