@inherits PreviewComponent
<div class="game-heading"><div><small>LIVE TABLE · SERVER STATE</small><h2>@Name</h2></div><span class="safe-badge">@TurnLabel</span></div>
<div class="live-players">@foreach(var p in Match.Get("players").Items()){<div class="live-player @(Match.Num("turn")==p.Num("seat")?"turn":"")"><span class="player-disc" style="@($"--seat:{Colors[p.Num("seat")%4]}")">@(p.Num("seat")+1)</span><div><b>@p.Get("user").Text("displayName",$"كمبيوتر {p.Num("seat")+1}")</b><small>@(p.Num("seat")==Match.Num("mySeat")?"أنت • ":"")@(Kind=="snakes"?"خانة "+p.Num("position"):Kind=="camel"?p.Num("progress")+"٪":p.Num("cardCount")+" أوراق")</small></div></div>}</div>
@if(Match.Text("status")=="waiting"){
<div class="connection-panel"><GameArt Kind="@Kind"/><h3>اجمع أصدقاءك</h3><p>شارك الكود من قسم الألعاب</p><strong class="room-code">@Match.Text("code")</strong><p>لاعبان على الأقل لبدء الجولة</p>@if(Match.Yes("host")){<button class="primary" data-live="start" disabled="@(!Session.CanAct||Match.Get("players").Items().Length<2)" @onclick='()=>Action("start")'>ابدأ الجولة</button>}</div>
}else if(Match.Text("status")=="cancelled"){<div class="control-guide"><h3>أُغلقت الطاولة</h3><p>ارجع للمجموعة لبدء جولة جديدة.</p><button class="secondary" @onclick='()=>Session.Send("closeTable")'>الرجوع للمجموعة</button></div>}
else{
@if(Match.Text("status")=="finished"){<div class="control-guide live-result"><h3>@ResultLabel</h3><p>الخبرة المكتسبة: @Match.Num("earnedXp") XP</p><button class="primary" data-live="result-close" @onclick='()=>Session.Send("closeTable")'>ارجع للمجموعة</button></div>}
@if(Kind=="uno"){
<div class="uno-arena live-uno"><div class="cloud c1"></div><div class="cloud c2"></div><div class="table-hud"><span><i></i> @TurnLabel</span><b>طاولة TOMI</b><span>@Match.Get("players").Items().Length مقاعد</span></div>
@for(int n=0;n<Opponents.Length;n++){var p=Opponents[n];<div class="seat @(n==0?"north":n==1?"west":"east")"><div class="avatar @(n==0?"peach":n==1?"blue":"purple")">@(p.Num("seat")+1)</div><b>@p.Get("user").Text("displayName","كمبيوتر")</b><small>@p.Num("cardCount") أوراق</small><div class="mini-backs">▰▰▰</div></div>}
<div class="island"><div class="table-ring"><div class="table-felt"><span class="table-brand">TOMI<br/><small>CARD CLUB</small></span><span class="direction">@(Match.Num("direction",1)>0?"↻":"↺")</span><div class="piles"><button class="deck-button" data-live="uno-deck" disabled="@(!Session.CanAct||!Match.Yes("canDraw"))" @onclick='()=>Action("draw")'><PlayingCard Card="Top" FaceDown="true"/></button><div class="discard" @key="Top.Id"><PlayingCard Card="Top"/></div></div><span class="table-note">اللون الحالي: @ColorName(Match.Text("activeColor")) • رزمة @Match.Num("deckCount")</span></div></div></div>
<div class="you"><i></i> أنت <span>@Hand.Length أوراق</span></div>
<div class="live-hand" role="group" aria-label="أوراقك" tabindex="0" @onkeydown="KeyHand">@foreach(var card in Hand){var id=card.Id;<button @key="id" data-live-card="@id" style="@HandStyle(id)" class="hand-card @(Selected==id?"selected":"")" disabled="@(!Session.MyTurn||!Playable.Contains(id))" aria-pressed="@(Selected==id)" aria-label="@($"{ColorName(card.Color??"wild")} {card.Symbol}")" @onclick="()=>Selected=id"><PlayingCard Card="card"/></button>}</div>
<div class="selection-readout">@(Selected is null?"اختار ورقة مسموحة من يدك":"ورقتك جاهزة • "+Hand.FirstOrDefault(c=>c.Id==Selected)?.Symbol)</div>
<div class="uno-controls"><button class="secondary" data-live="uno-draw" disabled="@(!Session.CanAct||!Match.Yes("canDraw"))" @onclick='()=>Action("draw")'>＋ اسحب</button><button class="primary" data-live="uno-play" disabled="@(!Session.MyTurn||Selected is null||!Playable.Contains(Selected))" @onclick="Play">العب الورقة</button>@if(Match.Yes("canPass")){<button class="secondary" data-live="uno-pass" disabled="@(!Session.CanAct)" @onclick='()=>Action("pass")'>مرّر</button>}<button class="uno-button @(Announced?"announced":"")" aria-pressed="@Announced" disabled="@(!Session.MyTurn)" @onclick="()=>Announced=!Announced">UNO!</button></div>
@if(ChooseColor){<div class="modal-shade" role="dialog" aria-modal="true" aria-label="اختيار اللون"><div class="color-dialog"><h3>اختار اللون التالي</h3><div class="color-options">@foreach(var color in CardColors){<button class="@color" aria-label="@ColorName(color)" @onclick="()=>SendCard(color)"></button>}</div><button class="secondary" @onclick="()=>ChooseColor=false">رجوع</button></div></div>}
</div>
}else if(Kind=="snakes"){
<div class="board-layout"><div class="snakes-board"><SnakesGraphic/>@foreach(var p in Match.Get("players").Items().Where(p=>p.Num("position")>0)){var pos=SnakeModel.Cell(p.Num("position"));<div class="snake-pawn" style="@FormattableString.Invariant($"left:{pos.X+(p.Num("seat")%2-.5)*2}%;top:{pos.Y}%;background:{Colors[p.Num("seat")%4]}")"><span>@(p.Num("seat")+1)</span></div>}</div><aside class="game-aside"><div class="mini-label">YOUR NEXT MOVE</div><div class="dice">@Match.Get("lastMove").Num("dice",1)</div><h3>@TurnLabel</h3><p>الرقم من الخادم. الوصول إلى 100 يحتاج الرقم بالضبط.</p><button class="primary" data-live="roll" disabled="@(!Session.MyTurn)" @onclick='()=>Action("roll")'>ارمِ النرد</button></aside></div>
}else if(Kind=="jackaroo"){
<div class="board-layout"><div class="jack-board"><JackGraphic/>@foreach(var p in Match.Get("players").Items()){var pawns=p.Get("pawns").Items();for(int i=0;i<pawns.Length;i++){int pawn=i,seat=p.Num("seat");var pos=PawnPoint(seat,pawns[i].TryNumber(-1),i);<div class="jack-pawn" style="@FormattableString.Invariant($"left:{pos.X}%;top:{pos.Y}%;background:{Colors[seat%4]}")">@(pawn+1)</div>}}</div><aside class="game-aside"><div class="mini-label">CHOOSE YOUR MOVE</div><h3>أوراقك الحقيقية</h3><p>اختار ورقة ثم حركة من الخيارات المسموحة. @(Match.Num("controlledSeat")==Match.Num("mySeat")?"":"أنت تساعد شريكك الآن.")</p><div class="jack-cards">@foreach(var c in Match.Get("hand").Items()){var id=c.Text("id");<button class="sample-card @(SelectedJack==id?"selected":"")" data-live-jack="@id" disabled="@(!Session.MyTurn||!Choices.Any(x=>x.Text("cardId")==id))" @onclick="()=>SelectedJack=id"><strong>@c.Text("value")</strong><span>@Suit(c.Text("suit"))</span></button>}</div><div class="legal-choices">@foreach(var c in Choices.Where(x=>x.Text("cardId")==SelectedJack)){var choice=c.Text("id");<button class="secondary" data-live-choice="@choice" disabled="@(!Session.MyTurn)" @onclick="()=>Choose(choice)">@c.Text("label")</button>}</div></aside></div>
}else if(Kind=="camel"){
<div class="board-layout camel-layout"><div class="camel-main"><div class="camel-topline"><span>طلب الفريق: @Match.Get("orders").Num("count") / @Match.Get("orders").Num("required",2)</span><span>@Match.Get("tiles").Items().Length قطعة متبقية</span></div><div class="camel-board">@foreach(var tile in Match.Get("tiles").Items().OrderBy(t=>t.Num("z"))){var id=tile.Text("id");bool free=Choices.Any(x=>x.Text("id")==id);<button class="match-tile @(free?"free":"covered")" data-live-tile="@id" disabled="@(!Session.MyTurn||!free)" style="@TileStyle(tile)" aria-label="قطعة @tile.Num("kind")" @onclick="()=>Choose(id)"><TileArt Kind='tile.Num("kind")'/></button>}</div><div class="tray-heading"><b>خانة التجميع</b><span>@Match.Get("tray").Items().Length / 7</span></div><div class="camel-tray">@for(int i=0;i<7;i++){<div class="tray-slot">@if(i<Match.Get("tray").Items().Length){<TileArt Kind='Match.Get("tray").Items()[i].Num("kind")'/>}</div>}</div>@if(Match.Get("side").Items().Length>0){<div class="side-storage"><small>المخزن الجانبي</small><div>@foreach(var tile in Match.Get("side").Items()){var choice="side:"+tile.Text("id");<button data-live-side="@choice" disabled="@(!Session.MyTurn)" @onclick="()=>Choose(choice)"><TileArt Kind='tile.Num("kind")'/></button>}</div></div>}</div><aside class="game-aside"><div class="mini-label">KEEP IT CLEAR</div><h3>ثلاثة.. وتختفي</h3><p>كل ثلاث قطع متشابهة تختفي. انتبه للخانات السبع وتعاون مع فريقك.</p><div class="helper-buttons">@foreach(var tool in Tools){var id="tool:"+tool.Id;<button class="secondary" data-live-tool="@tool.Id" disabled="@(!Session.MyTurn||!Choices.Any(x=>x.Text("id")==id))" @onclick="()=>Choose(id)">@tool.Name <span>@Match.Get("tools").Num(tool.Id)</span></button>}</div></aside></div>
}
}
<div class="status-line" role="status">@(Session.Waiting||Session.State.Yes("busy")?"ننتظر تأكيد الخادم…":TurnLabel)</div>
@code{
    [Parameter,EditorRequired]public NativeSession Session{get;set;}=default!;
    System.Text.Json.JsonElement Match=>Session.Match;
    string Kind=>Match.Text("kind");
    string Name=>Kind switch{"uno"=>"أونو • أوراق تومي","snakes"=>"السلم والأفعى","jackaroo"=>"جاكارو","camel"=>"الجمل المجنون",_=>"TOMI"};
    string TurnLabel=>Match.Text("status") switch{"waiting"=>"بانتظار الأصدقاء","finished"=>"انتهت الجولة","cancelled"=>"أُغلقت الطاولة",_=>Kind=="camel"?"فريقك يقدر يتحرك":Match.Num("turn")==Match.Num("mySeat")?"دورك الآن":"دور اللاعب "+(Match.Num("turn")+1)};
    string ResultLabel=>Kind=="camel"?(Match.Get("result").Text("reason")=="team_clear"?"فريقك أكمل اللوح!":"انتهت جولة الفريق"):Kind=="jackaroo"?"الفريق الفائز: "+(Match.Get("result").Num("winnerSeat")%2+1):"الفائز: اللاعب "+(Match.Get("result").Num("winnerSeat")+1);
    static readonly string[] Colors=["#ef6173","#5fa8e8","#efbe55","#51b88d"],CardColors=["red","blue","green","yellow"];
    static readonly (string Id,string Name)[] Tools=[("undo","تراجع"),("remove","نقل للمخزن"),("shuffle","خلط القطع")];
    string? Selected,SelectedJack;bool Announced,ChooseColor;
    Card[] Hand=>Match.Get("hand").Items().Select(CardFrom).ToArray();
    string HandStyle(string id){var cards=Hand;int i=Array.FindIndex(cards,c=>c.Id==id);double offset=i-(cards.Length-1)/2d;return FormattableString.Invariant($"--hand-angle:{Math.Clamp(offset,-6,6)*3.2}deg;--hand-arc:{Math.Min(Math.Abs(offset)*2,12)}px");}
    Card Top=>CardFrom(Match.Get("topCard"));
    static Card CardFrom(System.Text.Json.JsonElement c)=>new(c.Text("id"),c.Text("color") is var color&&color!=""?color:null,c.Text("value"));
    HashSet<string> Playable=>Match.Get("playableCardIds").Items().Select(x=>x.GetString()!).ToHashSet();
    System.Text.Json.JsonElement[] Opponents=>Match.Get("players").Items().Where(p=>p.Num("seat")!=Match.Num("mySeat")).ToArray();
    System.Text.Json.JsonElement[] Choices=>Match.Get("choices").Items();
    protected override void OnParametersSet(){if(!Hand.Any(c=>c.Id==Selected)||!Playable.Contains(Selected??"")){Selected=null;ChooseColor=false;}if(!Session.MyTurn)ChooseColor=false;}
    static string ColorName(string color)=>color switch{"red"=>"أحمر","blue"=>"أزرق","green"=>"أخضر","yellow"=>"أصفر",_=>"متعدد الألوان"};
    static string Suit(string suit)=>suit switch{"hearts"=>"♥","diamonds"=>"♦","clubs"=>"♣",_=>"♠"};
    Task Action(string type)=>Session.Send("action",new{type});
    Task Choose(string choice)=>Session.Send("choice",new{choice});
    async Task KeyHand(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e){
        if(!Session.MyTurn||ChooseColor)return;
        var allowed=Hand.Where(c=>Playable.Contains(c.Id)).ToArray();
        if(e.Key is "ArrowLeft" or "ArrowRight"&&allowed.Length>0){int at=Array.FindIndex(allowed,c=>c.Id==Selected);Selected=allowed[(at+(e.Key=="ArrowLeft"?1:-1)+allowed.Length)%allowed.Length].Id;}
        else if(e.Key=="Enter")await Play();else if(e.Key is "d" or "D"&&Match.Yes("canDraw"))await Action("draw");else if(e.Key=="Escape")Selected=null;
    }
    async Task Play(){var card=Hand.FirstOrDefault(c=>c.Id==Selected);if(card is null||!Session.MyTurn)return;if(card.Color is null){ChooseColor=true;return;}await SendCard(null);}
    async Task SendCard(string? color){ChooseColor=false;await Session.Send("action",new{type="play",cardId=Selected,color,uno=Announced});Selected=null;Announced=false;}
    static string Line((double X,double Y)a,(double X,double Y)b)=>FormattableString.Invariant($"M{a.X} {a.Y} Q{(a.X+b.X)/2+4} {(a.Y+b.Y)/2} {b.X} {b.Y}");
    static string TileStyle(System.Text.Json.JsonElement t)=>FormattableString.Invariant($"left:{(t.Num("x")+.4)/14*100}%;top:{(t.Num("y")+.4)/10*100}%;z-index:{t.Num("z")+1}");
    static (double X,double Y) PawnPoint(int seat,int pos,int pawn){double a=Math.PI/2+seat*Math.PI/2;if(pos>=64){double r=13+4.5*(pos-64);return(50+Math.Cos(a)*r,50+Math.Sin(a)*r);}if(pos<0){a=Math.PI*.75+seat*Math.PI/2;return(50+Math.Cos(a)*35+(pawn%2)*4.5,50+Math.Sin(a)*35+(pawn/2)*4.5);}return JackModel.Cell(seat,pos);}
}
